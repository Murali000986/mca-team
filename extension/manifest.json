{
  "manifest_version": 3,
  "name": "Ledgerly MCA Assistant",
  "version": "1.0.0",
  "description": "Fill SPICe+ Part A forms using approved Ledgerly client drafts.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Ledgerly MCA Assistant"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://*.mca.gov.in/*", "http://localhost:4000/*"],
      "js": ["field-map.js", "field-map-inc32.js", "content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "http://localhost:3000/*",
    "http://localhost:4000/*",
    "https://*.mca.gov.in/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
